{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend for instrument manager",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate:up": "node ./src/db/runMigrations.js up",
    "db:migrate:down": "node ./src/db/runMigrations.js down",
    "db:migrate:resetAll": "node ./src/db/runMigrations.js resetAll",
    "db:seed:up": "node ./src/db/runSeeds.js up",
    "db:seed:down": "node ./src/db/runSeeds.js down",
    "db:seed:resetAll": "node ./src/db/runSeeds.js resetAll"
  },
  "author": "Miika Takila",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  }
}
